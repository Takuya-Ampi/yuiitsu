  "keywords": [
    "api",
    "crud",
    "hono",
    "kysely",
    "openapi",
    "rest"
  ],
  "homepage": "https://github.com/Takuya-Ampi/yuiitsu#readme",
  "bugs": {
    "url": "https://github.com/Takuya-Ampi/yuiitsu/issues"
  },
  "license": "MIT",
  "author": "Takuya Ampi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Takuya-Ampi/yuiitsu.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
